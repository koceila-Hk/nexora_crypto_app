<?xml version="1.0" encoding="UTF-8"?>
<Configuration>

    <Properties>
        <Property name="LOG_PATH">/logs</Property>
        <Property name="LOG_FILE_NAME">backend</Property>
    </Properties>

    <Appenders>

        <Console name="ConsoleOutput" target="SYSTEM_OUT">
            <PatternLayout
                    pattern="%d{ISO8601} %-5level [%t] %logger{36} - %msg%n%throwable"/>
        </Console>

        <RollingFile name="LogFile"
                     fileName="${LOG_PATH}/${LOG_FILE_NAME}.log"
                     filePattern="${LOG_PATH}/backend-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout>
                <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </PatternLayout>

            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="10MB" />
            </Policies>

            <DefaultRolloverStrategy max="14"/>
        </RollingFile>

    </Appenders>

    <Loggers>

        <Root level="info">
            <AppenderRef ref="ConsoleOutput"/>
            <AppenderRef ref="LogFile"/>
        </Root>

        <!-- Optionnel : logs détaillés Mongo / SQL -->
        <Logger name="org.springframework.data.mongodb" level="info"/>
        <Logger name="org.hibernate.SQL" level="warn"/>

    </Loggers>

</Configuration>